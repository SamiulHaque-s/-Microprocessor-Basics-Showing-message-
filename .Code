.MODEL SMALL
.STACK 100H
.DATA
    msg  db 'Fast Name : M M Samiul $'
    msg1 db 'Last Name : Haque$'
    msg2 db 'Blood Group : B + $'
.CODE
MAIN PROC
    ; Initialize data segment
    MOV AX, @DATA
    MOV DS, AX

    ; Display msg (First Name line)
    MOV AH, 9
    LEA DX, msg
    INT 21H

    ; New line
    MOV AH, 2
    MOV DL, 0DH        ; carriage return
    INT 21H
    MOV DL, 0AH        ; line feed
    INT 21H

    ; Display msg1 (Last Name line)
    MOV AH, 9
    LEA DX, msg1
    INT 21H

    ; New line
    MOV AH, 2
    MOV DL, 0DH
    INT 21H
    MOV DL, 0AH
    INT 21H

    ; Display msg2 (Blood Group line)
    MOV AH, 9
    LEA DX, msg2
    INT 21H

    ; Exit program
    MOV AH, 4CH
    INT 21H
MAIN ENDP
END MAIN
